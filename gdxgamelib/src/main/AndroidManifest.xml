<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        LIBRARY manifest — Sketchware Pro does NOT merge this into your app's
        manifest automatically (verified: its manifest is fully generated by
        the IDE itself, not by AAR merging like Android Studio). So this one
        step below is done once, by hand, in your project's own Manifest
        editor (Project -> AndroidManifest.xml):

        <activity
            android:name="com.sketchgdx.gamelib.GdxGameActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="landscape"
            android:exported="true" />

        ===== แนะนำ (เสถียรที่สุด) =====
        เก็บ MainActivity ไว้เป็น LAUNCHER ตามปกติที่ Sketchware Pro สร้างให้
        (อย่าไปแก้ตรงนั้น เพราะ IDE จะ regenerate ทับได้) แล้วในบล็อกของ
        MainActivity -> onCreate ใส่แค่ 2 บล็อก:
          1) Intent -> Start Activity -> component: com.sketchgdx.gamelib.GdxGameActivity
          2) Activity -> Finish Activity
        แอปจะบูตผ่าน MainActivity ตามปกติแล้วสลับเข้าเกมทันทีในเฟรมเดียว
        ไม่มีจอกระพริบ และไม่ไปยุ่งกับส่วน manifest ที่ IDE ดูแลเอง

        ===== ทางเลือก (ถ้าอยากให้ GdxGameActivity เป็น LAUNCHER ตรงๆ) =====
        เสี่ยงกว่า เพราะ Sketchware Pro บางเวอร์ชัน regenerate
        <activity android:name=".MainActivity"> ทับตอน Save/Run ได้:

        <activity
            android:name="com.sketchgdx.gamelib.GdxGameActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        แล้วเอา <intent-filter> เดิมออกจาก <activity android:name=".MainActivity">
    -->
</manifest>
